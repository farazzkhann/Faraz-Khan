{% comment %}
  Custom Banner Section — TISSO VISON
  White bg, line-art illustration, bold heading bottom-left,
  black "SHOP NOW →" button (yellow hover fill), yellow "CHOOSE GIFT →" top-right nav button,
  bottom scrolling ticker strip. All text editable from customizer.
{% endcomment %}

<section class="custom-banner" id="custom-banner-{{ section.id }}">

  {%- comment -%}
    .custom-banner__container constrains all hero content to 1337px and
    centers it with margin: 0 auto. The section background remains 100% wide.
  {%- endcomment -%}
  <div class="custom-banner__container">

    {%- comment -%} Top-right nav button {%- endcomment -%}
    <div class="custom-banner__nav">
      <a href="{{ section.settings.choose_gift_url }}" class="custom-banner__nav-btn">
        {{ section.settings.choose_gift_label }} →
      </a>
    </div>

    {%- comment -%} Line-art illustration {%- endcomment -%}
    {%- if section.settings.illustration != blank -%}
      <div class="custom-banner__illustration">
        <img
          src="{{ section.settings.illustration | image_url: width: 1337 }}"
          alt="{{ section.settings.illustration.alt | escape }}"
          loading="eager"
          width="1337"
        >
      </div>
    {%- endif -%}

    {%- comment -%} Bottom-left heading + CTA {%- endcomment -%}
    <div class="custom-banner__content">
      <h1 class="custom-banner__heading">{{ section.settings.heading }}</h1>
      <a href="{{ section.settings.shop_now_url }}" class="custom-banner__shop-btn">
        {{ section.settings.shop_now_label }} →
      </a>
    </div>

  </div><!-- /.custom-banner__container -->

  {%- comment -%} Scrolling ticker strip — full width, outside the container {%- endcomment -%}
  <div class="custom-banner__ticker" aria-hidden="true">
    <div class="custom-banner__ticker-track">
      {%- assign ticker_text = section.settings.ticker_text -%}
      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      <span>{{ ticker_text }}</span>
      <span>{{ ticker_text }}</span>
      <span>{{ ticker_text }}</span>
      <span>{{ ticker_text }}</span>
    </div>
  </div>

</section>

<style>
  /* ── Banner wrapper ── */
  #custom-banner-{{ section.id }} {
    position: relative;
    background: #fff;
    width: 100%;
    min-height: {{ section.settings.min_height }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── Inner container: constrain content to 1337px, centered ── */
  /* Section background (#custom-banner-{{ section.id }}) stays 100% wide */
  .custom-banner__container {
    position: relative;
    max-width: 1337px;
    width: 100%;
    margin: 0 auto;
    height: 100%;
    /* Inherit the full section height so absolutely-positioned children work */
    min-height: inherit;
  }

  /* ── Top-right nav button ── */
  .custom-banner__nav {
    position: absolute;
    top: 24px;
    right: 32px;
    z-index: 10;
  }

  .custom-banner__nav-btn {
    display: inline-block;
    background: #f5c800;
    color: #111;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 10px 20px;
    border: 2px solid #111;
    transition: background 0.2s, color 0.2s;
  }

  .custom-banner__nav-btn:hover {
    background: #111;
    color: #f5c800;
  }

  /* ── Line-art illustration ── */
  .custom-banner__illustration {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-banner__illustration img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  /* ── Bottom-left heading + CTA ── */
  .custom-banner__content {
    position: absolute;
    bottom: 72px; /* above ticker */
    left: 40px;
    z-index: 10;
    max-width: 560px;
  }

  .custom-banner__heading {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.05;
    color: #111;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  /* Black button with yellow fill on hover */
  .custom-banner__shop-btn {
    display: inline-block;
    background: #111;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 28px;
    border: 2px solid #111;
    /* Yellow fill animates inward from left */
    background-image: linear-gradient(#f5c800, #f5c800);
    background-size: 0% 100%;
    background-repeat: no-repeat;
    background-position: left center;
    transition: background-size 0.35s ease, color 0.35s ease;
  }

  .custom-banner__shop-btn:hover {
    background-size: 100% 100%;
    color: #111;
  }

  /* ── Ticker strip ── */
  .custom-banner__ticker {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 44px;
    background: #111;
    overflow: hidden;
    display: flex;
    align-items: center;
    z-index: 10;
  }

  .custom-banner__ticker-track {
    display: flex;
    white-space: nowrap;
    animation: ticker-scroll {{ section.settings.ticker_speed }}s linear infinite;
  }

  .custom-banner__ticker-track span {
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0 48px;
  }

  .custom-banner__ticker-track span::after {
    content: '★';
    margin-left: 48px;
  }

  @keyframes ticker-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    #custom-banner-{{ section.id }} {
      min-height: 480px;
    }

    .custom-banner__nav {
      top: 16px;
      right: 16px;
    }

    .custom-banner__content {
      left: 20px;
      right: 20px;
      bottom: 60px;
      max-width: 100%;
      text-align: center;
    }

    .custom-banner__heading {
      font-size: clamp(1.8rem, 8vw, 2.6rem);
    }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "custom-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Illustration"
    },
    {
      "type": "image_picker",
      "id": "illustration",
      "label": "Line-art illustration image"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Banner min height (px)",
      "min": 400,
      "max": 900,
      "step": 20,
      "default": 680
    },
    {
      "type": "header",
      "content": "Heading & Shop Now button"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "The New\nEssentials."
    },
    {
      "type": "text",
      "id": "shop_now_label",
      "label": "Shop Now button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_now_url",
      "label": "Shop Now button URL"
    },
    {
      "type": "header",
      "content": "Choose Gift button (top-right)"
    },
    {
      "type": "text",
      "id": "choose_gift_label",
      "label": "Button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "choose_gift_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Ticker strip"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text (repeats automatically)",
      "default": "Free shipping on orders over $75   New arrivals every week   Shop the latest collection"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "label": "Ticker speed (seconds per loop)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
